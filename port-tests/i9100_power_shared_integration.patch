+IOReturn IOS7I9100Power::stopShared(OSObject *owner,void *,void *,void *,void *)
+{
+ IOS7I9100Power *s=(IOS7I9100Power *)owner;
+ if(s->timer){s->timer->disable();s->timer->cancelTimeout();}
